# Copy to .env (the start script does this for you) and fill in what you need.
# Everything is optional: with nothing set, the game runs with the offline mock guard.

# --- Guard brain -------------------------------------------------------------
# auto = Claude if ANTHROPIC_API_KEY is set, else Ollama if running, else the offline mock
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_JUDGE_MODEL=claude-haiku-5-5
# ANTHROPIC_EFFORT=low
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Langfuse (optional; install with: uv sync --extra langfuse) --------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse Cloud (EU) by default; for self-hosted use http://localhost:3000
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Server ------------------------------------------------------------------
# VAULT_HOST=0.0.0.0     # let other laptops on the same network join
# VAULT_PORT=8000
# HOST_PIN=              # PIN for /host; empty = random PIN printed at startup
# PROGRESSIVE_UNLOCK=true
