# Secrets: real keys live only in .env (copy .env.example)
.env

# Python and tooling caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/

# Local runtime data (database and trace log); keep the folder itself
data/*
!data/.gitkeep

# Personal settings and the design tool's local state (never committed)
/.claude/settings.local.json
/.impeccable/

# The Impeccable launcher binary (about 20 MB; rebuilt or downloaded locally)
/.claude/skills/impeccable/scripts/bin/
